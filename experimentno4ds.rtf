input:\par
\b0\fs22 #include <iostream>\par
#include <cstring>\par
using namespace std;\par
\par
struct Team\par
\{\par
    int id;\par
    char name[50];\par
    Team *next;\par
\};\par
\par
Team *head = NULL;\par
Team *current = NULL;\par
\par
\par
void addTeam()\par
\{\par
    Team *newTeam, *temp;\par
\par
    newTeam = new Team;\par
\par
    cout << "\\nEnter Team ID: ";\par
    cin >> newTeam->id;\par
\par
    cout << "Enter Team Name: ";\par
    cin >> newTeam->name;\par
\par
    newTeam->next = NULL;\par
\par
    if (head == NULL)\par
    \{\par
        head = newTeam;\par
        newTeam->next = head;\par
        current = head;\par
    \}\par
    else\par
    \{\par
        temp = head;\par
\par
        while (temp->next != head)\par
        \{\par
            temp = temp->next;\par
        \}\par
\par
        temp->next = newTeam;\par
        newTeam->next = head;\par
    \}\par
\par
    cout << "Team added successfully!\\n";\par
\}\par
\par
\par
void displayTeams()\par
\{\par
    Team *temp;\par
\par
    if (head == NULL)\par
    \{\par
        cout << "\\nNo teams available!\\n";\par
        return;\par
    \}\par
\par
    temp = head;\par
\par
    cout << "\\n----- Tournament Teams -----\\n";\par
\par
    do\par
    \{\par
        cout << "Team ID: " << temp->id\par
             << "  Team Name: " << temp->name << endl;\par
\par
        temp = temp->next;\par
\par
    \} while (temp != head);\par
\}\par
\par
void nextTeam()\par
\{\par
    if (current == NULL)\par
    \{\par
        cout << "\\nNo teams available!\\n";\par
        return;\par
    \}\par
\par
    current = current->next;\par
\par
    cout << "\\nCurrent Team: "\par
         << current->name << endl;\par
\}\par
\par
\par
void roundRobin()\par
\{\par
    Team *first;\par
    Team *second;\par
\par
    if (head == NULL)\par
    \{\par
        cout << "\\nNo teams available!\\n";\par
        return;\par
    \}\par
\par
    first = head;\par
\par
    cout << "\\n===== ROUND ROBIN SCHEDULE =====\\n";\par
\par
    do\par
    \{\par
        second = first->next;\par
\par
        while (second != head)\par
        \{\par
            cout << first->name << " vs " << second->name << endl;\par
            second = second->next;\par
        \}\par
\par
        first = first->next;\par
\par
    \} while (first != head);\par
\}\par
\par
\par
int main()\par
\{\par
    int choice;\par
\par
    do\par
    \{\par
        cout << "\\n===== TOURNAMENT ROUND ROBIN =====\\n";\par
        cout << "1. Add Team\\n";\par
        cout << "2. Display Teams\\n";\par
        cout << "3. Next Team\\n";\par
        cout << "4. Generate Round Robin Schedule\\n";\par
        cout << "5. Exit\\n";\par
\par
        cout << "Enter your choice: ";\par
        cin >> choice;\par
\par
        switch (choice)\par
        \{\par
            case 1:\par
                addTeam();\par
                break;\par
\par
            case 2:\par
                displayTeams();\par
                break;\par
\par
            case 3:\par
                nextTeam();\par
                break;\par
\par
            case 4:\par
                roundRobin();\par
                break;\par
\par
            case 5:\par
                cout << "\\nProgram ended.\\n";\par
                break;\par
\par
            default:\par
                cout << "\\nInvalid choice!\\n";\par
        \}\par
\par
    \} while (choice != 5);\par
\par
    return 0;\par
\}\par
