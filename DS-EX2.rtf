#include<iostream>\par
#include<string>\par
using namespace std;\par
\par
\par
class Node\par
\{\par
    public:\par
        int id;\par
        string name;\par
        double salary;\par
        Node* next;\par
\};\par
\par
int main()\par
\{\par
    Node* head = NULL;\par
    Node* temp = NULL;\par
    Node* newnode = NULL; \par
    int n;\par
    \par
    \par
    cout << " Enter number of employees: ";\par
    cin >> n;\par
    \par
    for(int i = 0; i < n; i++)\par
    \{\par
        newnode = new Node(); \par
        \par
        cout << " \\nEnter ID: "; \par
        cin >> newnode->id;\par
        cout << " \\nEnter Name: ";\par
        cin >> newnode->name;\par
        cout << " \\nEnter Salary: ";\par
        cin >> newnode->salary;\par
        \par
        newnode->next = NULL;\par
        \par
        if(head == NULL)\par
        \{\par
            head = newnode;\par
            temp = newnode;    \par
        \}\par
        else \par
        \{\par
            temp->next = newnode;\par
            temp = newnode;    \par
        \}\par
    \}\par
    \par
    \par
    cout << "\\n--- Linked List ---\\n";\par
    temp = head;\par
    while(temp != NULL)\par
    \{\par
        cout << "[" << temp->id << ", " << temp->name << ", $" << temp->salary << "] -> ";\par
        temp = temp->next;\par
    \}\par
    cout << "NULL\\n";\par
    \par
    \par
    int search_id;\par
    cout << "\\n Enter ID to search: ";\par
    cin >> search_id;\par
    \par
    temp = head;\par
    bool found = false;\par
    while(temp != NULL)\par
    \{\par
        if(temp->id == search_id)\par
        \{\par
            cout << " Found! Name: " << temp->name << " | Salary: $" << temp->salary << "\\n";\par
            found = true;\par
            break;\par
        \}\par
        temp = temp->next;\par
    \}\par
    if(!found) cout << " Employee not found.\\n";\par
\par
   \par
    int delete_id;\par
    cout << "\\n Enter ID to delete: ";\par
    cin >> delete_id;\par
    \par
    temp = head;\par
    Node* prev = NULL;\par
    \par
\par
    while(temp != NULL && temp->id != delete_id)\par
    \{\par
        prev = temp;       \par
        temp = temp->next; \par
    \}\par
    \par
    if(temp == NULL)\par
    \{\par
        cout << " ID not found. No deletion made.\\n";\par
    \}\par
    else\par
    \{\par
       \par
        if(temp == head)\par
        \{\par
            head = head->next;\par
        \}\par
        \par
        else\par
        \{\par
            prev->next = temp->next;\par
        \}\par
        delete temp; \par
        cout << " Deleted successfully!\\n";\par
    \}\par
    \par
    \par
    cout << "\\n--- Updated Linked List ---\\n";\par
    temp = head;\par
    while(temp != NULL)\par
    \{\par
        cout << "[" << temp->id << ", " << temp->name << ", $" << temp->salary << "] -> ";\par
        temp = temp->next;\par
    \}\par
    cout << "NULL\\n";\par
    \par
    return 0;\par
\}\par
\par

